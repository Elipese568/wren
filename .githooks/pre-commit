#!/bin/sh
# 提交前对暂存区的 C++ 文件跑 clang-format，并把格式化结果重新加入暂存区。
#
# 启用：git config core.hooksPath .githooks
# 找不到 clang-format 时只警告不阻塞（CI/无 LLVM 的机器仍可提交）。

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

find_clang_format() {
    if [ -n "${CLANG_FORMAT:-}" ] && [ -x "$CLANG_FORMAT" ]; then
        printf '%s\n' "$CLANG_FORMAT"
        return 0
    fi
    if command -v clang-format >/dev/null 2>&1; then
        command -v clang-format
        return 0
    fi
    for candidate in \
        "/c/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-format.exe" \
        "/c/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang-format.exe" \
        "/c/Program Files/LLVM/bin/clang-format.exe" \
        "/c/Program Files (x86)/LLVM/bin/clang-format.exe"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

formatter=$(find_clang_format || true)
if [ -z "$formatter" ]; then
    echo "pre-commit: 未找到 clang-format，跳过格式化（可设置 CLANG_FORMAT 指向可执行文件）" >&2
    exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h' | sort -u)
if [ -z "$files" ]; then
    exit 0
fi

changed=""
for file in $files; do
    [ -f "$file" ] || continue
    before=$(git rev-parse ":$file" 2>/dev/null || true)
    "$formatter" -i --style=file "$file"
    git add -- "$file"
    after=$(git rev-parse ":$file" 2>/dev/null || true)
    if [ "$before" != "$after" ]; then
        changed="$changed $file"
    fi
done

if [ -n "$changed" ]; then
    echo "pre-commit: clang-format 已格式化:$changed"
fi
